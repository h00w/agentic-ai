{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic AI Academy Artifact Manifest",
  "type": "object",
  "required": [
    "id",
    "type",
    "source_lesson",
    "summary",
    "paths",
    "evidence",
    "maturity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "code",
        "skill",
        "agent",
        "mcp",
        "schema",
        "policy",
        "evaluation",
        "trace",
        "threat_model",
        "runbook",
        "architecture",
        "release_evidence"
      ]
    },
    "source_lesson": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "claim"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "maturity": {
      "type": "string",
      "enum": [
        "learning",
        "tested",
        "release-candidate",
        "production-evidence"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
