{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic AI Academy Lesson Metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "module",
    "level",
    "duration_minutes",
    "prerequisites",
    "outcomes",
    "artifacts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "module": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "leadership"
      ]
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 15
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
